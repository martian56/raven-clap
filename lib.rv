// raven-clap: command-line argument parsing for Raven.
//
//     from "github.com/martian56/raven-clap" import Command, Arg
//     from std.env import args
//
//     fun main() {
//         let cmd = Command.new("greet").version("1.0").about("say hello").args([
//             Arg.flag("loud", "l", "shout it"),
//             Arg.option("times", "n", "how many times"),
//             Arg.positional("name", "who to greet"),
//         ])
//         match cmd.parse(args()) {
//             Ok(m) -> {
//                 if m.help() { print(cmd.usage()) }
//                 let who = m.get_or("name", "world")
//                 // ...
//             },
//             Err(e) -> print(e.to_string()),
//         }
//     }
//
// It handles `--long`, `--long=value`, `--long value`, short `-x` flags and
// `-x value` options, and positionals. `--help`/`-h` are recognized without
// being declared.

import std.string
import std.collections

// What an argument is: a boolean flag, a value-taking option, or a positional.
enum ArgKind {
    Flag,
    Value,
    Positional,
}

// One argument's spec. Build these with the constructors below rather than the
// struct literal.
class Arg {
    name: str
    short: str
    help: str
    kind: ArgKind
    required: bool
}

impl Arg {
    // A boolean flag, like `--verbose` / `-v`.
    fun flag(name: str, short: str, help: str) -> Arg {
        return Arg(name: name, short: short, help: help, kind: ArgKind.Flag, required: false)
    }

    // An option that takes a value, like `--output FILE` / `-o FILE`.
    fun option(name: str, short: str, help: str) -> Arg {
        return Arg(name: name, short: short, help: help, kind: ArgKind.Value, required: false)
    }

    // A required option: parsing fails if it is not given.
    fun required(name: str, short: str, help: str) -> Arg {
        return Arg(name: name, short: short, help: help, kind: ArgKind.Value, required: true)
    }

    // A positional argument, matched in declaration order.
    fun positional(name: str, help: str) -> Arg {
        return Arg(name: name, short: "", help: help, kind: ArgKind.Positional, required: false)
    }

    fun is_flag(self) -> bool {
        return match self.kind {
            case Flag { true }
            case Value { false }
            case Positional { false }
        }
    }

    fun is_positional(self) -> bool {
        return match self.kind {
            case Positional { true }
            case Flag { false }
            case Value { false }
        }
    }
}

// What can go wrong while parsing.
enum ClapError {
    UnknownArg(str),
    MissingValue(str),
    MissingRequired(str),
}

impl ToString for ClapError {
    fun to_string(self) -> str {
        return match self {
            case UnknownArg(a) { "unknown argument: ${a}" }
            case MissingValue(a) { "missing a value for: ${a}" }
            case MissingRequired(a) { "missing required argument: ${a}" }
        }
    }
}

// The result of a successful parse: a lookup of option and positional values, a
// list of positionals in order, and whether help was asked for.
class Matches {
    values: dict[str, str]
    positionals: list[str]
    help_seen: bool
}

impl Matches {
    // Whether a flag was set, or an option/positional was given a value.
    fun flag(self, name: str) -> bool {
        return self.values.has(name)
    }

    // The value for `name`, if it was given.
    fun get(self, name: str) -> Option[str] {
        return self.values.get(name)
    }

    // The value for `name`, or `fallback` when it is absent.
    fun get_or(self, name: str, fallback: str) -> str {
        return self.values.get_or(name, fallback)
    }

    // The positional at `i` (in the order they appeared), or `None`.
    fun positional(self, i: int) -> Option[str] {
        if i < 0 or i >= self.positionals.len() {
            return None
        }
        return Some(self.positionals[i])
    }

    // Every positional, in order.
    fun rest(self) -> list[str] {
        return self.positionals
    }

    // Whether `--help` or `-h` was passed.
    fun help(self) -> bool {
        return self.help_seen
    }
}

// A command: a name, optional version and description, and its argument specs.
class Command {
    name: str
    version: str
    about: str
    specs: list[Arg]
}

impl Command {
    fun new(name: str) -> Command {
        return Command(name: name, version: "", about: "", specs: _no_args())
    }

    fun version(self, v: str) -> Command {
        return Command(name: self.name, version: v, about: self.about, specs: self.specs)
    }

    fun about(self, a: str) -> Command {
        return Command(name: self.name, version: self.version, about: a, specs: self.specs)
    }

    // Set the argument specs. Build the list with the `Arg` constructors.
    fun args(self, specs: list[Arg]) -> Command {
        return Command(name: self.name, version: self.version, about: self.about, specs: specs)
    }

    // Parse `argv` (as returned by `std/env.args()`, with the program path at
    // index 0). Returns the matches, or the first error encountered.
    fun parse(self, argv: list[str]) -> Result[Matches, ClapError] {
        let values: dict[str, str] = Map.new()
        let positionals: list[str] = []
        var help_seen = false
        var pos_index = 0
        var i = 1
        while i < argv.len() {
            let tok = argv[i]
            if tok == "--help" or tok == "-h" {
                help_seen = true
                i += 1
            } else if tok.starts_with("--") {
                let body = tok.substring(2, tok.length())
                let eq = body.index_of("=")
                var name = body
                var inline = ""
                var has_inline = false
                if eq >= 0 {
                    name = body.substring(0, eq)
                    inline = body.substring(eq + 1, body.length())
                    has_inline = true
                }
                match self._find_long(name) {
                    case Some(spec) {
                        if spec.is_flag() {
                            values.set(spec.name, "true")
                            i += 1
                        } else if has_inline {
                            values.set(spec.name, inline)
                            i += 1
                        } else if i + 1 < argv.len() {
                            values.set(spec.name, argv[i + 1])
                            i += 2
                        } else {
                            return Err(ClapError.MissingValue("--${name}"))
                        }
                    }
                    case None {
                        return Err(ClapError.UnknownArg("--${name}"))
                    }
                }
            } else if tok.starts_with("-") and tok.length() > 1 {
                let short = tok.substring(1, tok.length())
                match self._find_short(short) {
                    case Some(spec) {
                        if spec.is_flag() {
                            values.set(spec.name, "true")
                            i += 1
                        } else if i + 1 < argv.len() {
                            values.set(spec.name, argv[i + 1])
                            i += 2
                        } else {
                            return Err(ClapError.MissingValue("-${short}"))
                        }
                    }
                    case None {
                        return Err(ClapError.UnknownArg(tok))
                    }
                }
            } else {
                positionals.push(tok)
                let pos_specs = self._positionals()
                if pos_index < pos_specs.len() {
                    values.set(pos_specs[pos_index].name, tok)
                    pos_index += 1
                }
                i += 1
            }
        }
        match self._missing_required(values) {
            case Some(name) {
                return Err(ClapError.MissingRequired(name))
            }
            case None {}
        }
        return Ok(Matches(values: values, positionals: positionals, help_seen: help_seen))
    }

    // A formatted help string: the name and version, the description, a usage
    // line, and the options with their help text.
    fun usage(self) -> str {
        var head = self.name
        if self.version != "" {
            head = "${head} ${self.version}"
        }
        var out = "${head}\n"
        if self.about != "" {
            out = "${out}${self.about}\n"
        }
        out = "${out}\nUSAGE:\n  ${self.name} [OPTIONS]"
        let p = self._positionals()
        var k = 0
        while k < p.len() {
            out = "${out} <${p[k].name}>"
            k += 1
        }
        out = "${out}\n\nOPTIONS:\n"
        // Line the help text up in a column, padding to the widest label.
        var width = "-h, --help".length()
        var w = 0
        while w < self.specs.len() {
            let label = _spec_label(self.specs[w])
            if label.length() > width {
                width = label.length()
            }
            w += 1
        }
        var i = 0
        while i < self.specs.len() {
            let a = self.specs[i]
            out = "${out}  ${_pad(_spec_label(a), width)}  ${a.help}\n"
            i += 1
        }
        out = "${out}  ${_pad("-h, --help", width)}  show this help\n"
        return out
    }

    fun _find_long(self, name: str) -> Option[Arg] {
        var i = 0
        while i < self.specs.len() {
            let a = self.specs[i]
            if a.name == name and not a.is_positional() {
                return Some(a)
            }
            i += 1
        }
        return None
    }

    fun _find_short(self, short: str) -> Option[Arg] {
        var i = 0
        while i < self.specs.len() {
            let a = self.specs[i]
            if a.short == short and not a.is_positional() {
                return Some(a)
            }
            i += 1
        }
        return None
    }

    fun _positionals(self) -> list[Arg] {
        let out: list[Arg] = []
        var i = 0
        while i < self.specs.len() {
            let a = self.specs[i]
            if a.is_positional() {
                out.push(a)
            }
            i += 1
        }
        return out
    }

    fun _missing_required(self, values: dict[str, str]) -> Option[str] {
        var i = 0
        while i < self.specs.len() {
            let a = self.specs[i]
            if a.required and not values.has(a.name) {
                return Some(a.name)
            }
            i += 1
        }
        return None
    }
}

fun _no_args() -> list[Arg] {
    let a: list[Arg] = []
    return a
}

// Right-pad `s` with spaces to `width` columns.
fun _pad(s: str, width: int) -> str {
    let n = width - s.length()
    if n <= 0 {
        return s
    }
    return s.concat(" ".repeat(n))
}

// The left column of a usage line for one spec, like "-o, --output" or
// "    --output" or "<input>".
fun _spec_label(a: Arg) -> str {
    if a.is_positional() {
        return "<${a.name}>"
    }
    if a.short != "" {
        return "-${a.short}, --${a.name}"
    }
    return "    --${a.name}"
}
