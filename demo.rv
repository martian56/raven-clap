// A tiny greeter built on raven-clap. Build and run with:
//   raven build demo.rv -o greet
//   ./greet Alice --loud -n 2
//   ./greet --help
from std.io import print, println
import std.string
from std.env import args
from "./lib" import Command, Arg

fun main() {
    let cmd = Command.new("greet").version("1.0").about("a tiny greeter").args(
        [
            Arg.flag("loud", "l", "shout the greeting"),
            Arg.option("times", "n", "how many times to greet"),
            Arg.positional("name", "who to greet"),
        ],
    )
    match cmd.parse(args()) {
        case Ok(m) {
            if m.help() {
                print(cmd.usage())
            } else {
                let who = m.get_or("name", "world")
                var line = "Hello, ".concat(who)
                if m.flag("loud") {
                    line = line.concat("!")
                }
                let n = match m.get_or("times", "1").parse_int() {
                    case Some(x) { x }
                    case None { 1 }
                }
                var i = 0
                while i < n {
                    println(line)
                    i += 1
                }
            }
        }
        case Err(e) { println(e.to_string()) }
    }
}
