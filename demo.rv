// A tiny greeter built on raven-clap. Build and run with:
//   raven build demo.rv -o greet
//   ./greet Alice --loud -n 2
//   ./greet --help
import std/io { print, println }
import std/string
import std/env { args }
import "./lib" { Command, Arg }

fun main() {
    let cmd = Command.new("greet").version("1.0").about("a tiny greeter").args([Arg.flag("loud", "l", "shout the greeting"), Arg.option("times", "n", "how many times to greet"), Arg.positional("name", "who to greet")])
    match cmd.parse(args()) {
        Ok(m) -> {
            if m.help() {
                print(cmd.usage())
            } else {
                let who = m.get_or("name", "world")
                let line = "Hello, ".concat(who)
                if m.flag("loud") {
                    line = line.concat("!")
                }
                let n = match m.get_or("times", "1").parse_int() {
                    Some(x) -> x,
                    None -> 1,
                }
                let i = 0
                while i < n {
                    println(line)
                    i += 1
                }
            }
        },
        Err(e) -> println(e.to_string()),
    }
}
